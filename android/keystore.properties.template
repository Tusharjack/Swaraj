# SWARAJ Release Signing — keystore.properties
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to android/keystore.properties  (one level up from here, in the android/ folder)
# 2. Fill in the real values below
# 3. Never commit keystore.properties or the .jks/.keystore file to source control
#
# To generate a new keystore (run once):
#   keytool -genkey -v -keystore swaraj-release.jks -alias swaraj -keyalg RSA -keysize 2048 -validity 10000
# Then copy swaraj-release.jks into the android/ folder (it is gitignored).
#
storeFile=swaraj-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=swaraj
keyPassword=YOUR_KEY_PASSWORD
